{
  "name": "wattwise-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace=apps/web run dev",
    "build": "npm --workspace=apps/web run build",
    "lint": "npm --workspace=apps/web run lint",
    "preview": "npm --workspace=apps/web run preview",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "seed:db": "psql -h localhost -U ww -d wattwise -f scripts/seed.sql"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
