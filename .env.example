# ==============================================================================
# WattWise™ Monorepo Environment Configuration Template
# Copy this file to .env and configure values before starting services.
# ==============================================================================

# ── Go API Server (apps/api) ──────────────────────────────────────────────────
# MANDATORY: ENV must be 'development', 'staging', 'production', or 'test'
ENV=development
PORT=8080
API_PORT=8080
AWS_REGION=me-south-1

# Database Connectors (PostgreSQL 16)
DATABASE_URL=postgres://ww:devpassword@localhost:5432/wattwise?sslmode=disable
POSTGRES_URL=postgres://ww:devpassword@localhost:5432/wattwise?sslmode=disable
POSTGRES_DB=wattwise
POSTGRES_USER=ww
POSTGRES_PASSWORD=devpassword

# In-Memory Cache & Token Store (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Time-Series Telemetry (InfluxDB v2)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=wattwise-dev-token-replace-in-prod
INFLUXDB_ADMIN_TOKEN=wattwise-dev-token-replace-in-prod
INFLUXDB_ORG=wattwise
INFLUXDB_BUCKET=sensors
INFLUXDB_USER=ww
INFLUXDB_PASSWORD=devpassword123

# Message Streaming & Ingestion (Kafka & MQTT)
KAFKA_BROKERS=localhost:9092
MQTT_BROKER=mqtt://localhost:1883
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TLS_CERT=/run/secrets/mqtt-cert.pem

# Asymmetric RS256 Authentication & Session Keys
JWT_SECRET=demo_dev_jwt_secret_high_entropy_32_bytes_min_2026
JWT_ISSUER=wattwise.pk
JWT_EXPIRY_MINUTES=15
COOKIE_SECURE=false
RSA_PRIVATE_KEY_PATH=/run/secrets/rsa_private.pem
RSA_PUBLIC_KEY_PATH=/run/secrets/rsa_public.pem
# RSA_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n..."

# Bootstrap Super Administrator (Created on first database initialization)
ADMIN_EMAIL=admin@wattwise.pk
ADMIN_PASSWORD=GENERATE_SECURE_RANDOM_ADMIN_PASSWORD_MIN_16_CHARS

# CORS & Network Boundaries (Comma-separated; strictly NO localhost in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://app.wattwise.pk
CORS_ORIGIN=http://localhost:5173

# Regulatory & Corporate Banking (Mandatory in production/staging)
WATTWISE_SELLER_NTN=0814923-2
WATTWISE_SELLER_STRN=12-00-9983-001-99
WATTWISE_ESCROW_BANK="Meezan Bank Ltd (Islamic Banking Division)"
WATTWISE_ESCROW_IBAN=PK44MEZN0001234567890123

# On-Call Escalation Matrix (P1-1 dynamic assignees)
ONCALL_SEV1_ASSIGNEE="Engr. Hammad Raza (Lead On-Call) + Field Engineer"
ONCALL_SEV2_ASSIGNEE="Field Operations Technician (Faisalabad Cluster)"
ONCALL_SEV3_ASSIGNEE="Backend DevOps & Infrastructure Team"
ONCALL_SEV4_ASSIGNEE="ML Systems & Outage Model Engineer"

# ── React Web Frontend (apps/web) ─────────────────────────────────────────────
VITE_API_URL=http://localhost:8080/v1
VITE_API_BASE_URL=http://localhost:8080/v1
VITE_WS_URL=ws://localhost:8080/v1/ws
VITE_USE_MOCKS=false

# E2E Test Credentials (Playwright) — Sourced strictly from CI secrets in production
E2E_EMAIL=admin@wattwise.pk
E2E_PASSWORD=SET_VIA_CI_SECRETS_ONLY
E2E_FACTORY="Crescent Weaving & Dyeing Mills (Unit 4)"

# ── Python ML Engine & Retraining (apps/ml) ───────────────────────────────────
FACTORY_ID=fsd_mill_001
FEEDER_CODE=FSD-KHW-11KV-04
MODEL_STORE_PATH=/var/wattwise/models
ONNX_OUTPUT_PATH=apps/ml/models/gop_latest.onnx
WHATSAPP_API_TOKEN=demo_whatsapp_cloud_api_token

# Per-Feeder Calibrated Outage Thresholds
FEEDER_V_CRIT=375.0
FEEDER_V_WARN=392.0
FEEDER_DV_CRIT=-2.2
FEEDER_DV_WARN=-1.4
FEEDER_FREQ_CRIT=49.82
FEEDER_SCORE_THRESH=0.70

# ── Edge OS & Hardware Daemon (apps/edge) ─────────────────────────────────────
SIMULATION_MODE=false
REQUIRE_HARDWARE=false
GPIO_WATCHDOG_TIMEOUT_SEC=30
SQLITE_RING_BUFFER_PATH=/var/wattwise/buffer.db
