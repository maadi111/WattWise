# ==============================================================================
# WattWise™ Environment Configuration Template
# Copy this file to .env and fill in production secrets before deployment.
# ==============================================================================

# 1. Environment & API Server
# MANDATORY: ENV must be 'development', 'staging', or 'production'
ENV=development
PORT=8080
AWS_REGION=me-south-1

# 2. Authentication & Cryptographic Secrets
# MANDATORY: Set a high-entropy secret (e.g. openssl rand -base64 32). No default fallback.
JWT_SECRET=demo_dev_jwt_secret_high_entropy_32_bytes_min_2026
JWT_EXPIRY_MINUTES=15
COOKIE_SECURE=false

# 3. Bootstrap Super Admin (Initial user created in Postgres on first start)
ADMIN_EMAIL=admin@wattwise.local
ADMIN_PASSWORD=ChangeThisStrongPassword2026!

# 4. CORS & Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://wattwise.pk

# 5. Database & Storage Connectors
POSTGRES_DB=wattwise
POSTGRES_USER=ww
POSTGRES_PASSWORD=devpassword
POSTGRES_URL=postgres://ww:devpassword@localhost:5432/wattwise?sslmode=disable

INFLUXDB_USER=ww
INFLUXDB_PASSWORD=devpassword123
INFLUXDB_ORG=wattwise
INFLUXDB_BUCKET=sensors
INFLUXDB_ADMIN_TOKEN=dev-token-change-in-prod
INFLUXDB_URL=http://localhost:8086

KAFKA_BROKERS=localhost:9092
MQTT_BROKER_URL=mqtt://localhost:1883

# 6. Financial & Tax Details (Mandatory in production; use company NTN and escrow IBAN)
WATTWISE_SELLER_NTN=DEMO-NTN-0000000
WATTWISE_SELLER_STRN=DEMO-STRN-0000000
WATTWISE_ESCROW_BANK="Corporate Islamic Banking Partner"
WATTWISE_ESCROW_IBAN=PK00DEMO0000000000000000

# 7. Web Frontend Configuration
VITE_API_URL=http://localhost:8080/v1
VITE_USE_MOCKS=false

# 8. Edge & Simulation Mode Flag
SIMULATION_MODE=false
REQUIRE_HARDWARE=false

