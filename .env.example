# ==============================================================================
# WattWise™ Environment Configuration Template
# Copy this file to .env and fill in production secrets before deployment.
# ==============================================================================

# 1. Environment & API Server
ENV=development
PORT=8080
AWS_REGION=me-south-1

# 2. Authentication & Cryptographic Secrets
# MANDATORY IN PRODUCTION: Generate a high-entropy secret (e.g. openssl rand -base64 32)
JWT_SECRET=wattwise_super_secret_jwt_key_pakistan_2026
JWT_EXPIRY_MINUTES=15
COOKIE_SECURE=false

# 3. CORS & Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://wattwise.pk

# 4. Database & Storage Connectors
POSTGRES_DB=wattwise
POSTGRES_USER=ww
POSTGRES_PASSWORD=devpassword
POSTGRES_URL=postgres://ww:devpassword@localhost:5432/wattwise?sslmode=disable

INFLUXDB_USER=ww
INFLUXDB_PASSWORD=devpassword123
INFLUXDB_ORG=wattwise
INFLUXDB_BUCKET=sensors
INFLUXDB_ADMIN_TOKEN=dev-token-change-in-prod
INFLUXDB_URL=http://localhost:8086

KAFKA_BROKERS=localhost:9092
MQTT_BROKER_URL=mqtt://localhost:1883

# 5. Financial & Tax Reconciliations (FBR & Meezan Corporate API)
WATTWISE_SELLER_NTN=9041284-7
WATTWISE_SELLER_STRN=3277876123456
WATTWISE_ESCROW_BANK="Meezan Bank Ltd. (Islamic Corporate Banking)"
WATTWISE_ESCROW_IBAN=PK42MEZN0001000987654321

# 6. Web Frontend Configuration
VITE_API_URL=http://localhost:8080/v1

# 7. Simulation Mode Flag
# Set to 'false' in production when physical hardware meters and database clusters are active
SIMULATION_MODE=true
